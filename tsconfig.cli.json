{
  "compilerOptions": {
    "rootDir": "languages/generator",
    "outDir": "lib/cli",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "skipLibCheck": true
  },
  "files": ["languages/generator/bin.ts"]
}

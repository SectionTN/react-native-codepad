{
  "name": "react-native-codepad",
  "version": "0.1.0",
  "description": "Native code editor for React Native",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-codepad-source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "nitrogen",
    "nitro.json",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-codepad-example",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib build",
    "prepare": "bob build",
    "nitrogen": "nitrogen && node scripts/sync-view-config.mjs",
    "gen:languages": "node languages/generator/cli.ts gen",
    "gen:report": "node languages/generator/cli.ts report",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc",
    "test": "jest && node --test \"languages/generator/*.test.ts\" \"tests/**/*.test.ts\"",
    "test:android": "cd example/android && ./gradlew :react-native-codepad:testDebugUnitTest --console=plain -q",
    "test:device": "scripts/device-tests.sh",
    "host:treesitter": "scripts/build-host-treesitter.sh",
    "bench:scroll": "scripts/bench.sh scroll",
    "bench:memory": "scripts/bench.sh memory",
    "bench:typing": "scripts/bench.sh typing",
    "ime:record": "scripts/ime-record.sh",
    "release": "release-it --only-version",
    "docs": "yarn workspace react-native-codepad-website dev",
    "docs:build": "yarn workspace react-native-codepad-website build"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "code-editor",
    "tree-sitter",
    "nitro"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SectionTN/react-native-codepad.git"
  },
  "author": "Rayen Sbai <rayensbai2@gmail.com> (https://github.com/SectionTN)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/SectionTN/react-native-codepad/issues"
  },
  "homepage": "https://github.com/SectionTN/react-native-codepad#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@commitlint/config-conventional": "^21.2.0",
    "@jest/globals": "^29.7.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@release-it/conventional-changelog": "^12.0.0",
    "@testing-library/react-native": "14.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "commitlint": "^21.2.1",
    "del-cli": "^7.0.0",
    "jest": "^29.7.0",
    "lefthook": "^2.1.10",
    "nitrogen": "0.37.1",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-builder-bob": "^0.43.1",
    "react-native-nitro-modules": "0.37.1",
    "release-it": "^21.0.1",
    "test-renderer": "1.2.0",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-native": ">=0.81.0",
    "react-native-nitro-modules": "^0.37.1"
  },
  "workspaces": [
    "example",
    "languages/*",
    "website"
  ],
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "custom",
        {
          "script": "nitrogen",
          "clean": "nitrogen/"
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}",
      "requireBranch": "main",
      "requireCleanWorkingDir": true
    },
    "npm": {
      "publish": false
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "conventionalcommits"
        },
        "infile": "CHANGELOG.md"
      }
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "passWithNoTests": true,
    "testEnvironmentOptions": {
      "customExportConditions": [
        "require",
        "react-native",
        "react-native-codepad-source"
      ]
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/",
      "<rootDir>/languages/",
      "<rootDir>/website/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/languages/",
      "<rootDir>/tests/",
      "<rootDir>/website/"
    ]
  },
  "create-react-native-library": {
    "type": "nitro-view",
    "languages": "kotlin-swift",
    "tools": [
      "jest",
      "lefthook",
      "release-it"
    ],
    "version": "0.63.1"
  }
}

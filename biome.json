{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!docs",
      "!.wolf",
      "!.claude",
      "!example/android",
      "!example/ios",
      "!.yarn",
      "!nitrogen",
      "!lib",
      "!cpp",
      "!languages/.cache",
      "!languages/*/grammar",
      "!languages/*/android",
      "!languages/*/ios",
      "!languages/*/queries",
      "!src/specs/CodeEditorViewConfig.ts",
      "!website/.docusaurus",
      "!website/build"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/specs/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noBannedTypes": "off"
          }
        }
      }
    },
    {
      "includes": ["languages/generator/**"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          },
          "suspicious": {
            "noTemplateCurlyInString": "off"
          }
        }
      }
    },
    {
      "includes": ["languages/grammars.json", "tests/vectors/**", "tests/ime/**"],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["website/src/snippets/**"],
      "formatter": {
        "lineWidth": 80
      }
    }
  ]
}
